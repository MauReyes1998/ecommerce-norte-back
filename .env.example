# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Base de datos (PostgreSQL local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/norte?schema=public

# Autenticación (se usa en el módulo Auth)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# Mercado Pago (modo prueba, se usa en el módulo Payments)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
MP_WEBHOOK_URL=http://localhost:3000/api/v1/payments/webhook
FRONTEND_URL=http://localhost:5173

# Correo (opcional). Sin SMTP_HOST, los correos se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NORTE <no-reply@norte.mx>"
