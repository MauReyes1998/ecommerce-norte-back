// NORTE · esquema de base de datos (PostgreSQL)
// Dinero en Decimal(10,2), MXN. Ids UUID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  HOMBRE
  MUJER
  UNISEX
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  addresses    Address[]
  orders       Order[]
  favorites    Favorite[]
  resetTokens  PasswordResetToken[]

  @@map("users")
}

/// Token de "olvidé mi contraseña". Se guarda el hash, nunca el token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Línea de tiempo del pedido para el panel admin.
model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actor      String      @default("sistema") // "sistema", "mercadopago" o el correo del admin
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String
  gender      Gender
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  basePrice   Decimal          @db.Decimal(10, 2)
  salePrice   Decimal?         @db.Decimal(10, 2)
  /// Precio vigente (salePrice ?? basePrice). Lo mantiene la app al crear/editar; sirve para filtrar y ordenar.
  currentPrice Decimal         @db.Decimal(10, 2)
  isFeatured  Boolean          @default(false)
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  images      ProductImage[]
  favorites   Favorite[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([gender, isActive])
  @@index([currentPrice])
  @@map("products")
}

/// Cada combinación talla + color es una variante con su propio SKU y stock.
model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  size       String // XS-XL o número de calzado (25, 26.5, ...)
  color      String
  colorHex   String?
  stock      Int         @default(0)
  price      Decimal?    @db.Decimal(10, 2) // si es null usa el precio del producto
  salePrice  Decimal?    @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@map("product_images")
}

/// Dirección de envío en formato mexicano.
model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  street       String
  extNumber    String
  intNumber    String?
  neighborhood String // colonia
  city         String // municipio o alcaldía
  state        String
  postalCode   String   @db.Char(5)
  references   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("addresses")
}

model Order {
  id              String        @id @default(uuid())
  number          Int           @unique @default(autoincrement()) // se muestra como NOR-000123
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  status          OrderStatus   @default(PENDIENTE)
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  /// Copia de la dirección al momento de comprar (no cambia si el cliente edita su dirección).
  shippingAddress Json
  paymentProvider String        @default("mercadopago")
  paymentStatus   PaymentStatus @default(PENDING)
  mpPreferenceId  String?
  mpPaymentId     String?       @unique
  paidAt          DateTime?
  trackingCarrier String?
  trackingNumber  String?
  adminNote       String?
  items           OrderItem[]
  history         OrderStatusHistory[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("orders")
}

/// Copia del producto al momento de la compra para que el historial no cambie con el catálogo.
model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  size        String
  color       String
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal         @db.Decimal(10, 2)

  @@map("order_items")
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@map("favorites")
}
