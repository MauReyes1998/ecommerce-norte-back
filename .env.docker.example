# Copia a .env.docker y edita. Lo lee docker compose con --env-file .env.docker
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

DB_PASSWORD=cambia-esta-contraseña
JWT_SECRET=cambia-esto-por-32-caracteres-aleatorios
JWT_EXPIRES_IN=7d

# Mercado Pago (TEST-... para pruebas). El webhook debe ser una URL pública: PUBLIC_URL/api/v1/payments/webhook
MP_ACCESS_TOKEN=
MP_WEBHOOK_URL=

# Correo (opcional; sin SMTP_HOST se imprime en la consola del backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NORTE <no-reply@norte.mx>

# Número de WhatsApp del botón de la tienda (con lada, sin +)
WHATSAPP=5217221234567
